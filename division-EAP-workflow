// Plain REST GET (instead of the client library) so the response headers are
// readable. Same call count as the client would make.
async function restGet(path, label) {
  const token = process.env.EAP_SERVICE_KEY_TOKEN;
  const response = await fetch(`https://api.hubapi.com${path}`, {
    headers: { Authorization: `Bearer ${token}`, Accept: 'application/json' }
  });
  const info = {};
  response.headers.forEach((value, name) => {
    if (name.toLowerCase().startsWith('x-hubspot-ratelimit')) {
      info[name.toLowerCase().replace('x-hubspot-ratelimit-', '').replace('x-hubspot-ratelimit', 'burst-max')] = value;
    }
  });
  if (Object.keys(info).length) rateInfo = info;
  if (!response.ok) {
    const error = new Error(`${label}: HTTP ${response.status}`);
    error.statusCode = response.status;
    error.code = response.status;
    error.isAxiosError = true;
    error.response = { status: response.status, statusCode: response.status, headers: {} };
    throw error;
  }
  return response.json();
}

// All IDs associated to a record, following pagination. Optionally keeps only
// links that carry the given association type ID.
async function associatedIds(client, fromType, fromId, toType, typeId, limit) {
  const ids = [];
  let after;
  const seen = new Set();
  for (let page = 0; page < 200; page += 1) {
    const query = `limit=500${after != null ? `&after=${encodeURIComponent(after)}` : ''}`;
    const response = await withRetry(
      () =>
        restGet(
          `/crm/v4/objects/${fromType}/${fromId}/associations/${toType}?${query}`,
          `${fromType} ${fromId} -> ${toType} associations`
        ),
      `${fromType} ${fromId} -> ${toType} associations`
    );
    for (const item of response.results || []) {
      const types = (item.associationTypes || []).map((t) => Number(t.typeId));
      if (typeId == null || types.includes(typeId) || types.length === 0) {
        ids.push(text(item.toObjectId));
      }
    }
    if (limit && ids.length > limit) {
      throw new Error(
        `${fromType} ${fromId} has more than ${limit} ${toType} associations; refusing partial data`
      );
    }
    const next = response.paging?.next?.after;
    if (next == null) return ids;
    if (seen.has(String(next))) throw new Error('Repeated pagination cursor');
    seen.add(String(next));
    after = next;
  }
  throw new Error('Association paging exceeded its safety limit; refusing partial data');
}

async function readDivisions(client, ids) {
  const out = [];
  for (let i = 0; i < ids.length; i += 100) {
    const chunk = ids.slice(i, i + 100);
    const response = await withRetry(
      () =>
        client.crm.objects.batchApi.read(DIVISION_TYPE, {
          properties: DIVISION_PROPERTIES,
          propertiesWithHistory: [],
          inputs: chunk.map((id) => ({ id }))
        }),
      'Division batch read'
    );
    out.push(...(response.results || []));
  }
  return out;
}

// ----- Roll-up ----------------------------------------------------------------------

function isEligible(division) {
  const p = division.properties || {};
  return (
    num(p.eligible_invoice_amount) > 0 &&
    text(p.market_is_enabled).toLowerCase() !== 'false' &&
    text(p.buyer_division_uuid).trim() !== '' &&
    !isBlockedBuyer(text(p.buyer_division_uuid))
  );
}

// A buyer is blocked when it is not on the allowlist, or it is paused/suppressed.
function isBlockedBuyer(uuid) {
  const u = text(uuid).trim().toLowerCase();
  return !ALLOWED_BUYER_UUIDS.has(u) || SUPPRESSED_BUYERS.has(u);
}

function isTruthyCell(v) {
  return v === true || v === 1 || String(v).trim().toLowerCase() === 'true' || String(v).trim() === '1';
}

// Pure helper (easy to test): HubDB rows -> Set of suppressed buyer UUIDs.
function suppressedFromRows(rows, nowMs) {
  const out = new Set();
  for (const row of rows || []) {
    const v = row.values || {};
    const uuid = text(v.buyer_uuid).trim().toLowerCase();
    if (!uuid || !isTruthyCell(v.active)) continue;
    const resume = v.resume_on;
    if (resume != null && resume !== '') {
      const ms = typeof resume === 'number' ? resume : Date.parse(resume);
      if (Number.isFinite(ms) && ms <= nowMs) continue; // pause has ended
    }
    out.add(uuid);
  }
  return out;
}

async function loadSuppressedBuyers() {
  if (!PAUSE_TABLE_ENABLED) return new Set(EXCLUDED_BUYER_UUIDS);
  const response = await withRetry(
    () => restGet(`/cms/v3/hubdb/tables/${SUPPRESSION_TABLE}/rows?limit=500`, 'HubDB suppression table'),
    'HubDB suppression table'
  );
  const set = suppressedFromRows(response.results, Date.now());
  EXCLUDED_BUYER_UUIDS.forEach((u) => set.add(u.toLowerCase()));
  return set;
}

// True when the contact is tied to at least one Division we can see and EVERY one
// of those Divisions belongs to a blocked buyer (not on the allowlist, or paused) (so we send nothing at all,
// not even a nudge about the company's other buyers).
function allLinkedDivisionsSuppressed(divisions, contactDivisionIds) {
  const linked = divisions.filter((d) => contactDivisionIds.has(text(d.id)));
  return (
    linked.length > 0 &&
    linked.every((d) => text(d.properties?.buyer_division_uuid).trim() !== '' && isBlockedBuyer(d.properties?.buyer_division_uuid))
  );
}

// One entry per unique buyer. Totals are only added within a single currency;
// if a buyer's Divisions span currencies the amount is left blank rather than
// adding unlike currencies together.
function rollUpByBuyer(companyDivisions, contactDivisionIds, locale, t) {
  const buyers = new Map();

  for (const division of companyDivisions) {
    if (!isEligible(division)) continue;
    const p = division.properties;
    const uuid = text(p.buyer_division_uuid).trim().toLowerCase();

    if (!buyers.has(uuid)) {
      buyers.set(uuid, {
        uuid,
        name: text(p.buyer_division_name).trim() || t.unnamed,
        associated: false,
        own: [],   // eligible Divisions the contact is tied to
        other: []  // eligible Divisions the contact is NOT tied to
      });
    }
    const buyer = buyers.get(uuid);
    if (contactDivisionIds.has(text(division.id))) {
      buyer.associated = true;
      buyer.own.push(division);
    } else {
      buyer.other.push(division);
    }
  }

  for (const buyer of buyers.values()) {
    const counted =
      MIXED_BUYER_MODE === 'all_company_divisions'
        ? [...buyer.own, ...buyer.other]
        : buyer.own;

    let invoices = 0;
    const byCurrency = new Map();
    let earliestFunds = '';
    for (const d of counted) {
      const p = d.properties;
      invoices += num(p.eligible_invoice_count);
      const cur = text(p.currency).trim().toUpperCase() || 'USD';
      byCurrency.set(cur, (byCurrency.get(cur) || 0) + num(p.eligible_invoice_amount));
      const funds = text(p.market_good_funds_date).trim();
      if (funds && (!earliestFunds || funds < earliestFunds)) earliestFunds = funds;
    }
    buyer.invoices = invoices;
    buyer.currency = byCurrency.size === 1 ? [...byCurrency.keys()][0] : '';
    buyer.amount = byCurrency.size === 1 ? [...byCurrency.values()][0] : null;
    buyer.sortAmount = Math.max(0, ...byCurrency.values());
    // Ranking amount over ALL of the buyer's eligible Divisions (used to pick the
    // top buyer when the contact is tied to none of them).
    const allByCur = new Map();
    for (const d of [...buyer.own, ...buyer.other]) {
      const cur = text(d.properties.currency).trim().toUpperCase() || 'USD';
      allByCur.set(cur, (allByCur.get(cur) || 0) + num(d.properties.eligible_invoice_amount));
    }
    buyer.rankAmount = Math.max(0, ...allByCur.values());
    buyer.fundsDate = formatDate(earliestFunds, locale);
  }

  return [...buyers.values()];
}

// ----- HTML blocks ---------------------------------------------------------------
// Rules applied (bulletproof email tables): numbers/dates never break
// (nowrap + word-break:normal), buyer names wrap normally, no fixed column
// widths on money, table sized to a 560px usable width (600px email minus
// 20px padding each side). CONFIRM that padding against the real template.

const FONT = 'font-family:Arial,Helvetica,sans-serif;';
const NUM_CELL =
  'padding:8px 10px;border-bottom:1px solid #e5e7eb;text-align:right;white-space:nowrap;word-break:normal;overflow-wrap:normal;';
const TEXT_CELL =
  'padding:8px 10px;border-bottom:1px solid #e5e7eb;text-align:left;white-space:normal;word-break:normal;overflow-wrap:break-word;';
const HEAD_NUM =
  'padding:8px 10px;background:#f3f4f6;font-weight:bold;text-align:right;white-space:nowrap;word-break:normal;overflow-wrap:normal;';
const HEAD_TEXT =
  'padding:8px 10px;background:#f3f4f6;font-weight:bold;text-align:left;white-space:normal;word-break:normal;overflow-wrap:break-word;';

function buildAssociatedTable(rows, locale, t) {
  if (!rows.length) return '';
  const sorted = [...rows].sort((a, b) => b.sortAmount - a.sortAmount);
  const cap = sorted.length === MAX_ASSOCIATED_ROWS + 1 ? sorted.length : MAX_ASSOCIATED_ROWS;
  const shown = sorted.slice(0, cap);
  const hidden = sorted.length - shown.length;

  const body = shown
    .map((b) => {
      // A buyer whose Divisions use different currencies can't be added into one
      // number, so say so (the label may wrap onto two lines, unlike amounts).
      const amountCell = b.amount == null
        ? `<td style="${NUM_CELL.replace('white-space:nowrap;', 'white-space:normal;')}">${escapeHtml(t.multiCurrency)}</td>`
        : `<td style="${NUM_CELL}">${escapeHtml(formatMoney(b.amount, b.currency, locale))}</td>`;
      return `  <tr>
    <td style="${TEXT_CELL}">${escapeHtml(b.name)}</td>
    <td style="${NUM_CELL}">${escapeHtml(new Intl.NumberFormat(INTL_LOCALE[locale] || 'en-US').format(b.invoices))}</td>
    ${amountCell}
  </tr>`;
    })
    .join('\n');

  const more = hidden > 0
    ? `  <tr><td colspan="3" style="padding:8px 10px;${FONT}font-size:13px;color:#6b7280;">${escapeHtml(t.moreCustomers(hidden))}</td></tr>`
    : '';

  return `<div lang="${locale}" style="overflow-x:auto;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:560px;border-collapse:collapse;${FONT}font-size:14px;color:#111827;">
  <tr>
    <td style="${HEAD_TEXT}">${escapeHtml(t.colCustomer)}</td>
    <td style="${HEAD_NUM}">${escapeHtml(t.colInvoices)}</td>
    <td style="${HEAD_NUM}">${escapeHtml(t.colAmount)}</td>
  </tr>
${body}
${more}
</table>
</div>`.trim();
}

const BOX_OPEN =
  '<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;"><tr><td bgcolor="#eef3ff" style="background-color:#eef3ff;border-left:4px solid #2d50a8;padding:16px 18px;">';
const BOX_CLOSE = '</td></tr></table>';

// The blue box lives here (not in the email) so that when there is nothing to
// show, nothing is drawn. One buyer: the name goes in the heading, no list.
function buildMissingBlock(missing, companyName, locale, t, messageType, linkUrl, unregistered) {
  if (!missing.length) return '';
  linkUrl = linkUrl || EXPAND_NETWORK_URL;
  // English wording (reviewed copy). Other languages keep the original wording below.
  const box = t.boxA && (messageType === 'nudge' ? t.boxB : t.boxA);

  if (missing.length === 1) {
    const useUnreg = !!(unregistered && box && box.bodyUnreg);
    const link = `<a href="${linkUrl}" style="color:#0b5cab;text-decoration:underline;">${escapeHtml(useUnreg ? box.linkUnreg : t.nudgeLinkOne)}</a>`;
    if (box) {
      const bodyOne = messageType === 'nudge' ? (unregistered && box.bodyOneNew ? box.bodyOneNew : box.bodyOne) : (useUnreg ? box.bodyUnreg(link) : box.body(link));
      return `${BOX_OPEN}<div lang="${locale}" style="${FONT}font-size:14px;line-height:1.5;color:#111827;max-width:560px;">
<p style="margin:0 0 10px 0;"><strong>${escapeHtml(box.headOne(missing[0].name))}</strong></p>
<p style="margin:0;">${bodyOne}</p>
</div>${BOX_CLOSE}`;
    }
    return `${BOX_OPEN}<div lang="${locale}" style="${FONT}font-size:14px;line-height:1.5;color:#111827;max-width:560px;">
<p style="margin:0 0 10px 0;"><strong>${escapeHtml(t.nudgeHeadingOne(companyName, missing[0].name))}</strong></p>
<p style="margin:0;">${t.nudgeBody(link)}</p>
</div>${BOX_CLOSE}`;
  }

  const names = [...missing]
    .sort((a, b) => a.name.localeCompare(b.name, INTL_LOCALE[locale] || 'en-US'))
    .map((b) => b.name);
  // Never hide just one name behind "and 1 more"; show it instead.
  const cap = names.length === MAX_MISSING_NAMES + 1 ? names.length : MAX_MISSING_NAMES;
  const shown = names.slice(0, cap);
  const hidden = names.length - shown.length;
  // Name "chips": one small outlined tag per buyer. In Outlook desktop the rounded
  // corners are ignored (they show as rectangles); everything else holds up.
  const CHIP = `display:inline-block;background:#ffffff;border:1px solid #c7d2ec;border-radius:14px;padding:4px 12px;margin:0 6px 8px 0;${FONT}font-size:13px;line-height:1.5;color:#111827;`;
  const items = shown
    .map((n) => `<span style="${CHIP}">${escapeHtml(n)}</span>`)
    .join('\n');
  const more = hidden > 0
    ? `\n<span style="display:inline-block;padding:4px 6px;${FONT}font-size:13px;line-height:1.5;color:#6b7280;">${escapeHtml(t.andMore(hidden))}</span>`
    : '';
  const useUnreg = !!(unregistered && box && box.bodyUnreg);
  const link = `<a href="${linkUrl}" style="color:#0b5cab;text-decoration:underline;">${escapeHtml(useUnreg ? box.linkUnreg : t.nudgeLink)}</a>`;

  const headHtml = box ? escapeHtml(box.head) : escapeHtml(t.nudgeHeading(companyName));
  const bodyHtml = box ? (messageType === 'nudge' ? (unregistered && box.bodyNew ? box.bodyNew : box.body) : (useUnreg ? box.bodyUnreg(link) : box.body(link))) : t.nudgeBody(link);
  return `${BOX_OPEN}<div lang="${locale}" style="${FONT}font-size:14px;line-height:1.5;color:#111827;max-width:560px;">
<p style="margin:0 0 10px 0;"><strong>${headHtml}</strong></p>
<p style="margin:0 0 10px 0;">${bodyHtml}</p>
<div style="margin:0;padding:0;">${items}${more}</div>
</div>${BOX_CLOSE}`;
}

// The email button link, built here so the email doesn't have to decide:
// registered contacts go to the app login for the top buyer, everyone else to
// the top buyer's microsite. Both end in "?partner=..." so the email can append
// "&lang=...&utm_link=...&utm_series=EAP".
// Registered contacts: Email B (nudge) goes to Expand Your Network, Email A goes to the app login
// for the top buyer. Non-registered contacts: always the top buyer's microsite.
function buildButtonUrl(permalink, registrationStatus, messageType) {
  if (text(registrationStatus).trim() !== '2') {
    return `https://${permalink}.c2fo.com/?partner=${permalink}`;
  }
  return messageType === 'nudge'
    ? EXPAND_NETWORK_URL
    : `https://app.c2fo.com/login?partner=${permalink}`;
}

function emptyOutput(reason) {
  console.log(`No EAP content: ${reason}`);
  return {
    message_type: 'none',
    company_name: '',
    associated_buyer_count: '0',
    missing_buyer_count: '0',
    associated_invoice_count: '0',
    associated_buyers_table: '',
    missing_buyers_block: '',
    missing_buyers_text: '',
    expand_network_url: EXPAND_NETWORK_URL,
    top_buyer_permalink: 'registration',
    top_buyer_name: '',
    top_buyer_microsite_url: 'https://registration.c2fo.com/',
    button_url: 'https://registration.c2fo.com/?partner=registration',
    subject_line: '', headline_text: '', intro_text: '', closing_text: '',
    footnote_text: '', button_label: ''
  };
}

// ----- Fast path: use the Company's pre-built snapshot (property eap_buyer_rollup) -----
// Returns pseudo-Division records, or null when the snapshot can't be trusted
// (then the live path below reads the Divisions directly, exactly as before).
function divisionsFromSnapshot(rawSnapshot, companyIds, contactDivisionIds) {
  const raw = text(rawSnapshot).trim();
  if (!raw) return null;
  let snap;
  try { snap = JSON.parse(raw); } catch (e) { return null; }
  if (!snap || snap.v !== 1 || !Array.isArray(snap.d) || !Array.isArray(snap.a)) return null;

  const builtAt = Date.parse(snap.t);
  if (!Number.isFinite(builtAt) || Date.now() - builtAt > MAX_ROLLUP_AGE_HOURS * 3600 * 1000) return null;

  // The contact must belong to exactly this one company, and every Division the
  // contact is tied to must be one this snapshot knows about.
  if (companyIds.length !== 1 || text(snap.i) !== text(companyIds[0])) return null;
  const known = new Set(snap.a.map(text));
  for (const id of contactDivisionIds) if (!known.has(id)) return null;

  return {
    companyName: text(snap.c).trim(),
    divisions: snap.d.map((r) => ({
      id: text(r[0]),
      properties: {
        buyer_division_uuid: r[1],
        buyer_division_name: (snap.n || {})[r[1]] || '',
        eligible_invoice_amount: r[2],
        eligible_invoice_count: r[3],
        currency: r[4],
        market_good_funds_date: r[5],
        market_is_enabled: 'true'
      }
    }))
  };
}

// Picks the highest-AP buyer among the buyers that appear in this email and
// returns its microsite permalink. Alert/both emails rank the buyers in the
// table (associated); nudge emails rank the buyers listed (missing). Amounts in
// different currencies are not converted: each buyer is ranked by its largest
// single-currency total. Buyers without a known permalink are skipped.
function pickTopBuyer(associated, missing) {
  const pool = associated.length
    ? associated.map((b) => ({ b, amt: b.sortAmount }))
    : missing.map((b) => ({ b, amt: b.rankAmount }));
  let best = null;
  for (const { b, amt } of pool) {
    const permalink = BUYER_PERMALINKS[b.uuid];
    if (!permalink) continue;
    if (!best || amt > best.amt) best = { permalink, name: b.name, amt };
  }
  return best;
}

// ----- Main ------------------------------------------------------------------------

exports.main = async (event) => {
  apiCalls = 0; // reset in case the runtime reuses this process between contacts
  let path = 'live';
  rateInfo = {};
  const startedAt = Date.now();
  // Dedicated service key for the EAP email so its API usage never competes with
  // AO V3 / Invoice Alerts. Intentionally NO fallback to the shared token.
  const token = process.env.EAP_SERVICE_KEY_TOKEN;
  if (!token) {
    throw new Error('Missing secret EAP_SERVICE_KEY_TOKEN (add it to this custom code action)');
  }
  const client = new hubspot.Client({ accessToken: token });

  const contactId = text(event.inputFields.contact_id).trim();
  const locale = resolveLocale(event.inputFields.contact_email_language);
  const t = LOCALES[locale];
  if (!contactId) return { outputFields: emptyOutput('no contact id') };

  // 1. The contact's Companies and Divisions
  const [companyIds, contactDivisionIdList, suppressed] = await Promise.all([
    associatedIds(client, 'contacts', contactId, 'companies'),
    associatedIds(client, 'contacts', contactId, DIVISION_TYPE, CONTACT_TO_DIVISION_ASSOC),
    loadSuppressedBuyers()
  ]);
  SUPPRESSED_BUYERS = suppressed;
  const contactDivisionIds = new Set(contactDivisionIdList);

  if (!companyIds.length && !contactDivisionIds.size) {
    return { outputFields: emptyOutput('contact has no company or division') };
  }

  // 2. Every Division on those Companies. Fast path: when the contact has exactly
  //    one Company, read that Company's pre-built snapshot (property
  //    eap_buyer_rollup) in a single call. Otherwise, or if the snapshot is
  //    missing/stale/doesn't match, read the Divisions live.
  let divisions;
  let companyNames = [];
  let fast = null;
  let singleCompany = null;
  if (!FORCE_LIVE_ROLLUP && companyIds.length === 1) {
    singleCompany = await withRetry(
      () => client.crm.companies.basicApi.getById(companyIds[0], ['name', 'eap_buyer_rollup']),
      `Company ${companyIds[0]} read`
    );
    fast = divisionsFromSnapshot(
      singleCompany.properties?.eap_buyer_rollup, companyIds, contactDivisionIds
    );
  }
  if (fast) {
    divisions = fast.divisions;
    companyNames = [fast.companyName || text(singleCompany.properties?.name).trim()];
    path = 'snapshot';
  } else {
    const divisionIds = new Set(contactDivisionIds);
    for (const companyId of companyIds) {
      const ids = await associatedIds(
        client, 'companies', companyId, DIVISION_TYPE,
        COMPANY_TO_DIVISION_ASSOC, MAX_DIVISIONS_PER_COMPANY
      );
      ids.forEach((id) => divisionIds.add(id));
      if (ids.length) {
        const company =
          singleCompany ||
          (await withRetry(
            () => client.crm.companies.basicApi.getById(companyId, ['name']),
            `Company ${companyId} read`
          ));
        companyNames.push(text(company.properties?.name).trim());
      }
    }
    divisions = await readDivisions(client, [...divisionIds]);
  }

  // 2b. Contact's own Divisions all belong to suppressed buyers: send nothing.
  if (allLinkedDivisionsSuppressed(divisions, contactDivisionIds)) {
    return { outputFields: emptyOutput('all of the contact\'s Divisions belong to blocked buyers') };
  }

  // 3. Roll up by unique buyer
  const buyers = rollUpByBuyer(divisions, contactDivisionIds, locale, t);
  const associated = buyers.filter((b) => b.associated);
  const missing = buyers.filter((b) => !b.associated);

  if (!associated.length && !missing.length) {
    return { outputFields: emptyOutput('no eligible buyers after filters') };
  }

  const companyName = companyNames.find(Boolean) || t.yourCompany;
  const messageType =
    associated.length && missing.length ? 'both'
    : associated.length ? 'alert'
    : 'nudge';

  const missingNames = [...missing]
    .map((b) => b.name)
    .sort((a, b) => a.localeCompare(b, INTL_LOCALE[locale] || 'en-US'));

  // Localized copy for the email's native modules ("middle path"): the email
  // inserts these as {{ custom.<name> }}.
  const nudgeOnly = messageType === 'nudge';
  const isUnregistered = text(event.inputFields.contact_registration_status).trim() !== '2';
  const oneMissing = missing.length === 1;
  const oneAssociated = associated.length === 1;
  const invoiceTotal = associated.reduce((sum, b) => sum + b.invoices, 0);
  const hasRealCompanyName = companyName !== t.yourCompany;
  // Date the amounts were read (send time), Kansas City time, e.g. "November 9, 2026".
  const asOfDate = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' });
  const copy = nudgeOnly
    ? {
        subject_line: oneMissing ? t.nudgeSubjectOne(companyName) : t.nudgeSubject(companyName),
        headline_text: typeof t.nudgeHeadline === 'function' ? t.nudgeHeadline(companyName) : t.nudgeHeadline,
        intro_text: '',
        button_label: (isUnregistered && t.nudgeButtonNew) ? t.nudgeButtonNew : (oneMissing ? t.nudgeButtonOne : t.nudgeButton),
        footnote_text: oneMissing ? t.nudgeFootnoteOne : t.nudgeFootnote
      }
    : {
        subject_line: typeof t.alertSubject === 'function' ? t.alertSubject(invoiceTotal, hasRealCompanyName ? companyName : '') : t.alertSubject,
        headline_text: typeof t.alertHeadline === 'function' ? t.alertHeadline(invoiceTotal) : t.alertHeadline,
        intro_text: oneAssociated ? t.alertIntroOne : t.alertIntro,
        button_label: t.alertButton,
        footnote_text: typeof t.alertFootnote === 'function' ? t.alertFootnote(asOfDate) : t.alertFootnote
      };

  const top = pickTopBuyer(associated, missing);
  const topPermalink = top ? top.permalink : 'registration';

  console.log(`top_buyer=${top ? top.permalink : 'none(fallback)'} path=${path} api calls=${apiCalls} ms=${Date.now() - startedAt} contact=${contactId} locale=${locale} ratelimit=${JSON.stringify(rateInfo)}`);
  return {
    outputFields: {
      ...copy,
      closing_text: t.alertClosing
        ? (nudgeOnly ? ((isUnregistered && t.nudgeClosingNew) ? (oneMissing ? t.nudgeClosingOneNew : t.nudgeClosingNew) : (oneMissing ? t.nudgeClosingOne : t.nudgeClosing)) : t.alertClosing)
        : t.closing,
      message_type: messageType,
      company_name: companyName,
      associated_buyer_count: String(associated.length),
      missing_buyer_count: String(missing.length),
      associated_invoice_count: String(associated.reduce((s, b) => s + b.invoices, 0)),
      associated_buyers_table: buildAssociatedTable(associated, locale, t),
      // Registered contacts: "add missing customers" goes to Expand Your Network in the app.
      // Non-registered contacts: the public "Find your buyer" page.
      missing_buyers_block: buildMissingBlock(missing, companyName, locale, t, messageType,
        text(event.inputFields.contact_registration_status).trim() === '2'
          ? EXPAND_NETWORK_URL
          : FIND_YOUR_BUYER_URL,
        text(event.inputFields.contact_registration_status).trim() !== '2'),
      missing_buyers_text: missingNames.slice(0, MAX_MISSING_NAMES).join(', '),
      expand_network_url: EXPAND_NETWORK_URL,
      top_buyer_permalink: topPermalink,
      top_buyer_name: top ? top.name : '',
      top_buyer_microsite_url: `https://${topPermalink}.c2fo.com/?partner=${topPermalink}`,
      button_url: buildButtonUrl(topPermalink, event.inputFields.contact_registration_status, messageType)
    }
  };
};
