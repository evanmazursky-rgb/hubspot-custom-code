function formatMoney(amount, currency, locale) {
  const code = text(currency).trim().toUpperCase() || 'USD';
  const tag = INTL_LOCALE[locale] || 'en-US';
  // Mexican pesos: keep the explicit "MX $" prefix used elsewhere (AO V3).
  if (code === 'MXN') {
    return `MX $${new Intl.NumberFormat(tag, { maximumFractionDigits: 0 }).format(amount)}`;
  }
  try {
    return new Intl.NumberFormat(tag, {
      style: 'currency',
      currency: code,
      maximumFractionDigits: 0
    }).format(amount);
  } catch {
    return `${Math.round(amount).toLocaleString(tag)} ${code}`.trim();
  }
}

function formatDate(value, locale) {
  const raw = text(value).trim();
  if (!raw) return '';
  const date = /^\d+$/.test(raw) ? new Date(Number(raw)) : new Date(raw);
  return Number.isNaN(date.getTime())
    ? ''
    : date.toLocaleDateString(INTL_LOCALE[locale] || 'en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC'
      });
}

