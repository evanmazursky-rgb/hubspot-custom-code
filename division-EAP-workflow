// ----- Small helpers ------------------------------------------------------------
const text = (v) => (v == null ? '' : String(v));
const num = (v) => (Number.isFinite(Number(v)) ? Number(v) : 0);

function escapeHtml(value) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

let apiCalls = 0; // counted per run, logged at the end (see "api calls" log line)

const statusOf = (error) =>
  Number(error?.response?.statusCode ?? error?.statusCode ?? error?.status ?? error?.code);

// Rate limits (429): HubSpot allows short bursts only (this key: 25 calls per second,
// 250 per 10 seconds), so when many contacts run at once some calls get a 429.
// Retry up to 4 times with growing waits plus random jitter (about 8 seconds in the
// worst case, well inside the 20-second action limit), then fail so the workflow
// can retry the action later.
// Server errors / network blips: up to 2 short retries.
const RATE_LIMIT_WAITS_MS = [800, 1600, 2400, 3200];
async function withRetry(operation, label) {
  let rateLimitRetries = 0;
  let otherRetries = 0;
  for (;;) {
    try {
      apiCalls += 1;
      return await operation();
    } catch (error) {
      const status = statusOf(error);
      if (status === 429) {
        if (rateLimitRetries >= RATE_LIMIT_WAITS_MS.length) {
          console.log(`${label}: still rate limited after ${rateLimitRetries} retries; rethrowing so HubSpot retries this action later`);
          throw error;
        }
        const wait = RATE_LIMIT_WAITS_MS[rateLimitRetries] + Math.floor(Math.random() * 500);
        rateLimitRetries += 1;
        console.log(`${label} rate limited; retry ${rateLimitRetries}/${RATE_LIMIT_WAITS_MS.length} in ${wait}ms`);
        await sleep(wait);
        continue;
      }
      const transient =
        status >= 500 || ['ECONNRESET', 'ETIMEDOUT', 'EAI_AGAIN'].includes(error?.code);
      if (!transient || otherRetries >= 2) throw error;
      otherRetries += 1;
      const wait = 300 * otherRetries;
      console.log(`${label} transient failure; retrying in ${wait}ms`);
      await sleep(wait);
    }
  }
}

// ----- Language ------------------------------------------------------------------
// The contact property hubspot_email_language holds free text. Values seen in the
// portal: "amer english", "global english", "german", "spanish", "french",
// "simplified chinese", "italian", "portuguese". Anything else falls back to English.
function resolveLocale(rawLanguage) {
  const v = text(rawLanguage).trim().toLowerCase();
  const is = (...keys) => keys.some((k) => v === k || v.startsWith(`${k}-`) || v.startsWith(`${k}_`));
  if (is('es') || v.includes('spanish') || v.includes('español')) return 'es';
  if (is('fr') || v.includes('french') || v.includes('français')) return 'fr';
  if (is('de') || v.includes('german') || v.includes('deutsch')) return 'de';
  if (is('it') || v.includes('italian') || v.includes('italiano')) return 'it';
  if (is('pt') || v.includes('portuguese') || v.includes('português')) return 'pt';
  if (is('zh') || v.includes('chinese') || v.includes('中文') || v.includes('简体')) return 'zh';
  return 'en';
}

