// ----------------------------------------------------------------------------
// RELIABILITY HELPERS
// HubSpot's API occasionally has hiccups (rate limits, brief outages). These
// three functions make the code automatically wait a moment and try again
// (up to 2 retries) instead of failing the whole workflow on a blip.
// ----------------------------------------------------------------------------

// Simple "wait for X milliseconds" helper
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

// Decides whether an error is the "temporary glitch" kind (worth retrying)
// vs. a real problem (not worth retrying)
const retryable = (error) => {
  const status = Number(
    error?.response?.statusCode ?? error?.statusCode ?? error?.status
  );

  return (
    status === 429 || // "too many requests" - rate limited
    status >= 500 ||   // HubSpot server-side error
    ['ECONNRESET', 'ETIMEDOUT', 'EAI_AGAIN'].includes(error?.code) // network blip
  );
};

// Runs a given API call, and if it fails with a "temporary glitch" error,
// waits briefly and tries again (up to 2 extra attempts) before giving up
async function withRetry(operation, label) {
  for (let attempt = 0; ; attempt += 1) {
    try {
      return await operation();
    } catch (error) {
      if (!retryable(error) || attempt >= 2) {
        throw error;
      }

      const wait = 250 * (attempt + 1);
      console.log(`${label} transient failure; retrying in ${wait}ms`);
      await sleep(wait);
    }
  }
}

// ----------------------------------------------------------------------------
// READING THE OFFER DETAILS OFF A CQ RECORD
// Each Campaign Qualification record stores its offer details (buyer name,
// discount, invoice amounts, etc.) as one big block of JSON text in a field
// called "payload_json". This function reads that text and turns it into
// a usable set of values. If the text is broken/invalid, it raises an error
// so the problem doesn't silently get ignored.
// ----------------------------------------------------------------------------
function parsePayload(record) {
  const raw = text(record.properties?.payload_json);

  if (!raw.trim()) {
    return null; // no payload at all — treat as "nothing to offer"
  }

  try {
    return JSON.parse(raw);
  } catch {
    throw new Error(
      `Campaign Qualification ${record.id} payload_json is not valid JSON`
    );
  }
}

// ----------------------------------------------------------------------------
// DATE HELPERS
// ----------------------------------------------------------------------------

// Converts a date-like value (which might be a raw timestamp number or a date
// string) into a plain number we can compare/sort by. Used to figure out
// which CQ was generated most recently.
function timestamp(value) {
  const raw = text(value).trim();

  if (!raw) {
    return Number.NEGATIVE_INFINITY;
  }

  const date = /^\d+$/.test(raw) ? new Date(Number(raw)) : new Date(raw);
  return Number.isNaN(date.getTime())
    ? Number.NEGATIVE_INFINITY
    : date.getTime();
}

// Converts a date-like value into a friendly, human-readable date such as
// "August 20, 2026" for display purposes (e.g. "good funds by" date)
function formatDate(value) {
  const raw = text(value).trim();

  if (!raw) {
    return '';
  }

  const date = /^\d+$/.test(raw) ? new Date(Number(raw)) : new Date(raw);

  return Number.isNaN(date.getTime())
    ? raw // if we can't parse it, just show the original text rather than lose it
    : date.toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric'
      });
}

// ----------------------------------------------------------------------------
// BUYER / OFFER BUSINESS LOGIC
// ----------------------------------------------------------------------------

// Reads how many customers/invoices this offer covers ("number of customers"
// can appear under two slightly different field names in the payload).
// Returns null if it's missing or not a valid positive number.
function customerCount(payload) {
  const value =
    payload?.number_of_customers ?? payload?.['number of customers'];

  if (value == null || text(value).trim() === '') {
    return null;
  }

  const parsed = Number(value);
  return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
}

// Labels the offer as "single_buyer" (exactly one customer/invoice covered)
// or "multi_buyer" (more than one). This flag gets used later in the
// workflow/email to phrase things correctly ("your invoice" vs "your invoices").
function buyerFlag(payload) {
  const count = customerCount(payload);

  if (count == null) {
    return null;
  }

  return count === 1 ? 'single_buyer' : 'multi_buyer';
}

// ----------------------------------------------------------------------------
// "NOTHING TO SHOW" FALLBACK
// If we can't find a valid offer to present (no CQs, all excluded, or
// missing required info), this builds a safe, blank set of output fields
// so the rest of the workflow doesn't break — it just shows no offer.
// `rawCount` records how many CQ records existed in total, purely for
// reporting/debugging purposes.
// ----------------------------------------------------------------------------
function emptyOutput(rawCount) {
  return {
    matching_cq_count: '0',
    raw_matching_cq_count: String(rawCount),
    cq_match_status: 'none',
    buyer_count_flag: '',
    selected_offers_json: '[]',
    selected_primary_cq_id: '',
    selected_primary_payload_json: '',
    draft_offers_table: '',
    campaign_user_status: 'null',
    buyer_logo_url: FALLBACK_LOGO_URL,
    auth_service_uuid: '',
    currency: '',
    discount_amount: '',
    discounted_amount: '',
    draft_offer_uuid: '',
    eligible_invoice_amount: '',
    good_funds_date_picker: '',
    non_reg_buyer_exclusion_flag: 'no',
    leading_maker_organization_uuid: '',
    number_of_customers: '',
    number_of_invoices: '',
    primary_buyer_division_uuid: '',
    primary_buyer_name: '',
    primary_buyer_permalink: '',
    rate: '',
    rate_type: ''
  };
}

// ----------------------------------------------------------------------------
// FINDING WHICH CAMPAIGN A CQ RECORD BELONGS TO
// Every CQ can be linked ("associated") to one or more Campaign records.
// This function looks up those links, fetches the actual Campaign records,
// and picks the one that matters most:
//   - If one of the linked campaigns IS our top-priority "ENT Retail AO"
//     campaign, that one always wins.
//   - Otherwise, whichever linked campaign has the highest "priority" number wins.
// It returns the campaign's name, priority, and "user status" (a setting
// stored on the campaign that describes what state this contact is in).
// ----------------------------------------------------------------------------
async function campaignDetails(client, cqId) {
  // Step 1: find which Campaign record(s) this CQ is linked to
  const associations = await withRetry(
    () =>
      client.crm.associations.v4.basicApi.getPage(
        CQ_TYPE,
        cqId,
        CAMPAIGN_TYPE,
        undefined,
        100
      ),
    `CQ ${cqId} association lookup`
  );

  const ids = (associations.results || [])
    .filter(
      (item) =>
        !item.associationTypeId ||
        String(item.associationTypeId) === String(CAMPAIGN_ASSOCIATION_TYPE_ID)
    )
    .map((item) => text(item.toObjectId))
    .filter(Boolean);

  // No linked campaigns at all — nothing more we can determine
  if (!ids.length) {
    return {
      priority: Number.NEGATIVE_INFINITY,
      userStatus: 'null',
      campaignIds: [],
      campaignName: '',
      isPriorityCampaign: false
    };
  }

  // Step 2: fetch the actual Campaign records for those linked IDs
  const response = await withRetry(
    () =>
      client.crm.objects.searchApi.doSearch(CAMPAIGN_TYPE, {
        filterGroups: [
          {
            filters: [
              {
                propertyName: 'hs_object_id',
                operator: 'IN',
                values: ids
              }
            ]
          }
        ],
        properties: ['campaign_name', 'campaign_priority', 'campaign_config'],
        limit: 100
      }),
    `Campaign lookup for CQ ${cqId}`
  );

  // Step 3: decide which linked campaign "wins" —
  // the priority campaign always wins if present, otherwise highest priority number
  const campaigns = response.results || [];
  const priorityCampaign = campaigns.find(
    (campaign) =>
      text(campaign.properties?.campaign_name).trim().toLowerCase() ===
      NORMALIZED_PRIORITY_CAMPAIGN_NAME
  );
  const campaign =
    priorityCampaign ||
    campaigns
      .slice()
      .sort(
        (a, b) =>
          number(b.properties?.campaign_priority) -
          number(a.properties?.campaign_priority)
      )[0];

  if (!campaign) {
    return {
      priority: Number.NEGATIVE_INFINITY,
      userStatus: 'null',
      campaignIds: ids,
      campaignName: '',
      isPriorityCampaign: false
    };
  }

  // Campaigns store some extra settings (like "userStatus") as JSON text
  // in a "campaign_config" field — read that here too
  let config = {};

  try {
    config = campaign.properties?.campaign_config
      ? JSON.parse(campaign.properties.campaign_config)
      : {};
  } catch {
    throw new Error(
      `AO Campaign ${campaign.id} campaign_config is not valid JSON`
    );
  }

  return {
    campaignId: text(campaign.id),
    campaignIds: ids,
    campaignName: text(campaign.properties?.campaign_name).trim(),
    isPriorityCampaign: Boolean(priorityCampaign),
    priority: number(campaign.properties?.campaign_priority),
    userStatus:
      config.userStatus == null ? 'null' : text(config.userStatus)
  };
}

// ----------------------------------------------------------------------------
// TIE-BREAKER: choosing the "best" CQ between two candidates
// When there's more than one qualifying CQ to choose from, this decides
// which one wins:
//   1. First, whichever is tied to the higher-priority campaign wins.
//   2. If priority is tied, whichever was generated more recently wins.
// ----------------------------------------------------------------------------
function winner(first, second) {
  const priority = number(second.priority) - number(first.priority);

  if (priority) {
    return priority < 0 ? first : second;
  }

  const started = timestamp(second.started) - timestamp(first.started);
  return started < 0 ? first : second;
}

// ============================================================================
// MAIN ENTRY POINT
// This is the function HubSpot actually calls when a contact hits this step
// in the workflow. Everything above was just setup; this is where it all
// comes together.
// ============================================================================
exports.main = async (event, callback) => {
  const client = new hubspot.Client({
    accessToken: process.env.PRIVATE_APP_ACCESS_TOKEN
  });

  // ---- STEP 1: Get the contact's unique ID used to look up their offers ----
  const auth = text(event.inputFields.contact_auth_uuid);

  // No ID on the contact at all? There's nothing to look up — return empty.
  if (!auth) {
    return callback({
      outputFields: emptyOutput(0)
    });
  }

  // ---- STEP 2: Search for this contact's live, unexpired offer records ----
  const response = await withRetry(
    () =>
      client.crm.objects.searchApi.doSearch(CQ_TYPE, {
        filterGroups: [
          {
            filters: [
              {
                propertyName: 'recipient_auth_service_uuid',
                operator: 'EQ',
                value: auth
              },
              {
                propertyName: 'payload_kind',
                operator: 'EQ',
                value: 'ACTIONABLE_OFFER' // only real, actionable offers — not other record types
              },
              {
                propertyName: 'expires_at',
                operator: 'GT',
                value: String(Date.now()) // only offers that haven't expired yet
              }
            ]
          }
        ],
        properties: ['payload_json', 'source_run_started_at', 'expires_at'],
        limit: 100
      }),
    'Campaign Qualification search'
  );

  const records = response.results || [];

  // ---- STEP 3: Remove any records tied to buyers on our exclusion list ----
  const eligible = records.filter((record) => {
    const payload = parsePayload(record);

    return (
      payload &&
      !EXCLUDED_BUYERS.has(normalizeBuyer(payload.primary_buyer_name))
    );
  });

  // If nothing survives the exclusion filter, there's no offer to show
  if (!eligible.length) {
    return callback({
      outputFields: emptyOutput(records.length)
    });
  }

  // ---- STEP 4: For each surviving record, figure out its campaign details
  //              (priority, campaign name, user status) and whether its
  //              buyer is on the approved Retail list ----
  const candidates = await Promise.all(
    eligible.map(async (record) => {
      const payload = parsePayload(record);
      const buyerName = text(payload?.primary_buyer_name).trim();
      const details = await campaignDetails(client, record.id);

      return {
        ...details,
        id: text(record.id),
        raw: text(record.properties?.payload_json),
        payload,
        buyerName,
        isRetailEligibleBuyer: RETAIL_ELIGIBLE_BUYERS.has(
          normalizeBuyer(buyerName)
        ),
        started: text(record.properties?.source_run_started_at)
      };
    })
  );

  // ---- STEP 5: Split candidates into two pools ----
  // Pool A: candidates that ARE in the priority Retail campaign AND whose
  //         buyer is on the approved retail list (these get first dibs)
  // Pool B: everything else ("non-retail" candidates)
  const nonRetailCandidates = candidates.filter(
    (candidate) => !candidate.isPriorityCampaign
  );
  const eligibleRetailCandidates = candidates.filter(
    (candidate) =>
      candidate.isPriorityCampaign && candidate.isRetailEligibleBuyer
  );

  // If Pool A has anything in it, we choose from Pool A. Otherwise, choose
  // from Pool B. (A CQ that's in the priority campaign but NOT for an
  // approved retail buyer is effectively skipped — it counts toward neither
  // pool as a candidate to win.)
  const selectionPool =
    eligibleRetailCandidates.length > 0
      ? eligibleRetailCandidates
      : nonRetailCandidates;

  // ---- STEP 6: Pick the single best candidate from the chosen pool ----
  // (using the tie-breaker rules in the `winner` function above)
  const selected = selectionPool.reduce(
    (current, item) => (current ? winner(current, item) : item),
    null
  );

  // ---- STEP 7: Record a "match status" label describing how we got here,
  //              mostly useful for reporting/troubleshooting later ----
  let cqMatchStatus = 'none';

  if (eligibleRetailCandidates.length > 0) {
    cqMatchStatus = PRIORITY_CAMPAIGN_NAME; // we matched into the priority Retail campaign
  } else if (nonRetailCandidates.length === 1) {
    cqMatchStatus = 'one_match'; // exactly one non-retail candidate available
  } else if (nonRetailCandidates.length > 1) {
    cqMatchStatus = 'multiple_matches'; // had to pick a winner among several non-retail candidates
  }

  // ---- STEP 8: Log what happened, for visibility in HubSpot's workflow logs ----
  if (cqMatchStatus === PRIORITY_CAMPAIGN_NAME) {
    console.log(
      `cq_match_status=${PRIORITY_CAMPAIGN_NAME}: selected an eligible ENT Retail CQ for an approved buyer, taking precedence over ${nonRetailCandidates.length} qualifying non-retail CQ(s).`
    );
  } else if (nonRetailCandidates.length > 0) {
    const excludedRetailCount = candidates.filter(
      (candidate) =>
        candidate.isPriorityCampaign && !candidate.isRetailEligibleBuyer
    ).length;

    console.log(
      `cq_match_status=${cqMatchStatus}: selected from ${nonRetailCandidates.length} qualifying non-retail CQ(s). Ignored ${excludedRetailCount} ineligible retail CQ(s).`
    );
  } else {
    console.log(
      'cq_match_status=none: no qualifying non-retail CQ was found and no ENT Retail CQ matched the eligible buyer list.'
    );
  }

  // ---- STEP 9: Sanity check the winning record before using it ----
  // If the record we picked is missing critical info (buyer name, buyer
  // permalink, buyer division ID, or a valid customer count), we don't try
  // to guess — we bail out and show nothing rather than a broken offer.
  if (
    !selected?.raw ||
    !text(selected.payload?.primary_buyer_name).trim() ||
    !text(selected.payload?.primary_buyer_permalink).trim() ||
    !text(selected.payload?.primary_buyer_division_uuid).trim() ||
    !buyerFlag(selected.payload)
  ) {
    console.log(
      'Winning Campaign Qualification is missing buyer identity, buyer division UUID, or a valid number of customers'
    );

    return callback({
      outputFields: emptyOutput(records.length)
    });
  }

  const payload = selected.payload;
  const buyerName = text(payload.primary_buyer_name).trim();
  const buyerPermalink = text(payload.primary_buyer_permalink).trim();
  const buyerDivisionUuid = text(payload.primary_buyer_division_uuid).trim();
  const flag = buyerFlag(payload);

  // ---- STEP 10: Look up a logo image for this buyer ----
  // We check a HubDB table ("buyer_logos") for a matching row. If anything
  // goes wrong (buyer not found, lookup fails, etc.), we just fall back to
  // the generic C2FO logo rather than failing the whole workflow step.
  let logo = FALLBACK_LOGO_URL;

  try {
    const logoResponse = await withRetry(
      () =>
        client.apiRequest({
          method: 'GET',
          path: '/cms/v3/hubdb/tables/buyer_logos/rows',
          qs: {
            buyer_key__eq:
              buyerPermalink.toLowerCase() || buyerName.toLowerCase(),
            limit: 1
          }
        }),
      'Buyer logo lookup'
    );

    const value = (await logoResponse.json()).results?.[0]?.values?.logo_url;
    logo =
      typeof value === 'string' && value
        ? value
        : value?.url || FALLBACK_LOGO_URL;
  } catch (error) {
    console.log(`Buyer logo lookup failed: ${error.message || error}`);
  }

  // ---- STEP 11: Hand everything back to the workflow ----
  // This bundle of fields is what the rest of the HubSpot workflow (emails,
  // landing pages, personalization tokens, etc.) will use.
  callback({
    outputFields: {
      matching_cq_count: String(
        eligibleRetailCandidates.length > 0
          ? eligibleRetailCandidates.length
          : nonRetailCandidates.length
      ),
      raw_matching_cq_count: String(records.length),
      cq_match_status: cqMatchStatus,
      buyer_count_flag: flag,
      selected_offers_json: JSON.stringify([
        {
          cq_id: selected.id,
          payload_json: selected.raw,
          campaign_name: selected.campaignName,
          campaign_priority: selected.priority,
          source_run_started_at: selected.started
        }
      ]),
      selected_primary_cq_id: selected.id,
      selected_primary_payload_json: selected.raw,
      draft_offers_table: '',
      campaign_user_status: selected.userStatus || 'null',
      buyer_logo_url: logo,
      auth_service_uuid: text(payload.auth_service_uuid),
      currency: text(payload.currency),
      discount_amount: text(payload.discount_amount),
      discounted_amount: text(payload.discounted_amount),
      draft_offer_uuid: text(payload.draft_offer_uuid),
      eligible_invoice_amount: text(payload.eligible_invoice_amount),
      good_funds_date_picker: formatDate(
        payload.good_funds_date_picker || payload.good_funds_date
      ),
      non_reg_buyer_exclusion_flag: 'no',
      leading_maker_organization_uuid: text(
        payload.leading_maker_organization_uuid
      ),
      number_of_customers: text(
        payload.number_of_customers ?? payload['number of customers']
      ),
      number_of_invoices: text(payload.number_of_invoices),
      primary_buyer_division_uuid: buyerDivisionUuid,
      primary_buyer_name: buyerName,
      primary_buyer_permalink: buyerPermalink,
      rate: Number.isFinite(Number(payload.rate))
        ? Number(payload.rate).toFixed(1)
        : text(payload.rate),
      rate_type: text(payload.rate_type)
    }
  });
};
