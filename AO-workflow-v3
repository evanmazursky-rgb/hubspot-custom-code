function columnForOffer(offerType, payload, offerId, t) {
  const kind = offerKind(offerType);

  if (kind === 'preferred') {
    return {
      sortOrder: 0,
      title: t.preferredTitle,
      headerBg: '#dfeefa',
      cellBg: '#eff8fd',
      buttonBg: '#369DD9',
      ar: text(payload.eligible_invoice_amount),
      ratePercent: text(payload.rate),
      discount: text(payload.discount_amount),
      amount: text(payload.discounted_amount),
      frequencyLabel: t.lockedFor90,
      offerId: text(offerId),
      whyTitle: t.whyPreferredTitle,
      whyBullets: t.whyPreferredBullets
    };
  }

  if (kind === 'onetime') {
    return {
      sortOrder: 1,
      title: t.oneTimeTitle,
      headerBg: '#e9e9e9',
      cellBg: '#f7f7f7',
      buttonBg: '#2C324F',
