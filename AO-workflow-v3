// ----------------------------------------------------------------------------
// RELIABILITY HELPERS
// ----------------------------------------------------------------------------
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
 
const retryable = (error) => {
  // The Node 24 HubSpot client puts the HTTP status in error.code (a number,
  // e.g. 429). Older clients use statusCode / status / response.statusCode.
  const status = Number(
    error?.response?.statusCode ?? error?.statusCode ?? error?.status ?? error?.code
  );
 
  return (
    status === 429 ||
    status >= 500 ||
    ['ECONNRESET', 'ETIMEDOUT', 'EAI_AGAIN'].includes(error?.code)
  );
};
 
async function withRetry(operation, label) {
  const maxAttempts = 6;

  for (let attempt = 0; ; attempt += 1) {
    try {
      return await operation();
    } catch (error) {
      if (!retryable(error) || attempt >= maxAttempts - 1) {
        throw error;
      }

      // Honour Retry-After when HubSpot sends it (capped so one call can never
      // eat the whole action timeout); otherwise back off exponentially.
      const headers = error?.response?.headers || error?.headers || {};
      const retryAfterSeconds = Number(
        typeof headers.get === 'function' ? headers.get('retry-after') : headers['retry-after']
      );
      const base =
        Number.isFinite(retryAfterSeconds) && retryAfterSeconds > 0
          ? retryAfterSeconds * 1000
          : 500 * 2 ** attempt;
      const wait = Math.min(base, 4000) + Math.floor(Math.random() * 800);
      console.log(`${label} transient failure; retrying in ${wait}ms`);
      await sleep(wait);
    }
  }
}

function chunk(items, size) {
  const parts = [];
  for (let i = 0; i < items.length; i += size) parts.push(items.slice(i, i + size));
  return parts;
}

// Read every page so prior sent assets are not missed.
// Stop with an error rather than use a partial population at the safety cap.
// This helper performs reads only; it never marks a CQ sent.
async function searchAllCqs(client, request) {
  const results = [];
  let after;
  const seenCursors = new Set();
 
  for (let page = 0; page < 100; page += 1) {
    const pageRequest = { ...request };
    if (after != null) pageRequest.after = after;
 
    const response = await withRetry(
      () => client.crm.objects.searchApi.doSearch(CQ_TYPE, pageRequest),
      'Campaign Qualification search page'
    );
 
    results.push(...(response.results || []));
    const next = response.paging?.next?.after;
    if (next == null) return { results };
 
    const cursor = String(next);
    if (seenCursors.has(cursor)) {
      throw new Error('CQ search returned a repeated pagination cursor');
    }
    seenCursors.add(cursor);
    after = next;
  }
 
  throw new Error('CQ search exceeded its page safety limit; refusing partial selection');
}
 
