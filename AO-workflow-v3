// ----------------------------------------------------------------------------
// FINDING WHICH CAMPAIGN A CQ RECORD BELONGS TO
// ----------------------------------------------------------------------------
async function campaignDetails(client, cqId) {
  const associations = await withRetry(
    () =>
      client.crm.associations.v4.basicApi.getPage(
        CQ_TYPE,
        cqId,
        CAMPAIGN_TYPE,
        undefined,
        100
      ),
    `CQ ${cqId} association lookup`
  );

  const ids = (associations.results || [])
    .filter(
      (item) =>
        !item.associationTypeId ||
        String(item.associationTypeId) === String(CAMPAIGN_ASSOCIATION_TYPE_ID)
    )
    .map((item) => text(item.toObjectId))
    .filter(Boolean);

  if (!ids.length) {
    return {
      priority: Number.NEGATIVE_INFINITY,
      userStatus: 'null',
      campaignId: '',
      campaignIds: [],
      campaignName: '',
      normalizedCampaignName: '',
      isTopPriorityCampaign: false,
      isPriorityCampaign: false,
      isReducedRateCampaign: false,
      draftOfferAssets: []
    };
  }

  const response = await withRetry(
    () =>
      client.crm.objects.searchApi.doSearch(CAMPAIGN_TYPE, {
        filterGroups: [
          {
            filters: [
              {
                propertyName: 'hs_object_id',
                operator: 'IN',
                values: ids
              }
            ]
          }
        ],
        properties: ['campaign_name', 'campaign_priority', 'campaign_config'],
        limit: 100
      }),
    `Campaign lookup for CQ ${cqId}`
  );

  const campaigns = response.results || [];
  const topPriorityCampaign = campaigns.find(
    (campaign) =>
      text(campaign.properties?.campaign_name).trim().toLowerCase() ===
      NORMALIZED_TOP_PRIORITY_CAMPAIGN_NAME
  );
  const priorityCampaign = campaigns.find(
    (campaign) =>
      text(campaign.properties?.campaign_name).trim().toLowerCase() ===
      NORMALIZED_PRIORITY_CAMPAIGN_NAME
  );
  // Which campaign "governs" this CQ, when a CQ is (unusually) tied to more
  // than one Campaign record: named top-priority campaign first, named
  // Retail priority campaign next, otherwise whichever has the highest
  // campaign_priority number. Reduced Rate status is determined afterward,
  // below, from whichever campaign was picked here — it isn't a name match,
  // so it doesn't factor into this pick.
  const campaign =
    topPriorityCampaign ||
    priorityCampaign ||
    campaigns
      .slice()
      .sort(
        (a, b) =>
          number(b.properties?.campaign_priority) -
          number(a.properties?.campaign_priority)
      )[0];

  if (!campaign) {
    return {
      priority: Number.NEGATIVE_INFINITY,
      userStatus: 'null',
      campaignId: '',
      campaignIds: ids,
      campaignName: '',
      normalizedCampaignName: '',
      isTopPriorityCampaign: false,
      isPriorityCampaign: false,
      isReducedRateCampaign: false,
      draftOfferAssets: []
    };
  }

  let config = {};

  try {
    config = campaign.properties?.campaign_config
      ? JSON.parse(campaign.properties.campaign_config)
      : {};
  } catch {
    throw new Error(
      `AO Campaign ${campaign.id} campaign_config is not valid JSON`
    );
  }

  const campaignName = text(campaign.properties?.campaign_name).trim();
  const normalizedCampaignName = campaignName.toLowerCase();
  const draftOfferAssets = Array.isArray(config.draftOfferAssets)
    ? config.draftOfferAssets
    : [];

  return {
    campaignId: text(campaign.id),
    campaignIds: ids,
    campaignName,
    normalizedCampaignName,
    isTopPriorityCampaign: normalizedCampaignName === NORMALIZED_TOP_PRIORITY_CAMPAIGN_NAME,
    isPriorityCampaign: normalizedCampaignName === NORMALIZED_PRIORITY_CAMPAIGN_NAME,
    isReducedRateCampaign: isReducedRateCampaignConfig(draftOfferAssets),
    priority: number(campaign.properties?.campaign_priority),
    userStatus:
      config.userStatus == null ? 'null' : text(config.userStatus),
    draftOfferAssets
  };
}

// ----------------------------------------------------------------------------
// TIE-BREAKER: choosing the "best" CQ between two candidates
//   1. Whichever is tied to the higher-priority campaign wins.
//   2. If priority is tied, whichever was generated more recently
//      (source_run_started_at) wins.
// ----------------------------------------------------------------------------
function winner(first, second) {
  const priority = number(second.priority) - number(first.priority);

  if (priority) {
    return priority < 0 ? first : second;
  }

  const started = timestamp(second.started) - timestamp(first.started);
  return started < 0 ? first : second;
}

