// NOTE: labels were shortened (e.g. "Discount Amount" -> "Discount",
// "Early Payment Frequency" -> "Frequency") to match the latest sample HTML
// design, which reads cleaner on a narrow mobile column.
 
// Format MXN monetary values consistently in tables and workflow outputs.
// The currency field controls formatting; no currency conversion occurs.
// Remove existing peso prefixes or an MXN suffix to avoid duplicate labels.
// Preserve the amount's existing commas and decimal precision.
function formatTableCurrency(value, currency) {
  const amount = text(value).trim();
 
  if (text(currency).trim().toUpperCase() !== 'MXN' || !amount) {
    return amount;
  }
 
  const cleanAmount = amount
    .replace(/^(?:MX\s*\$|MXN\s*\$?|\$)\s*/i, '')
    .replace(/\s*MXN$/i, '')
    .trim();
 
  return cleanAmount ? `MX $${cleanAmount}` : '';
}
 
