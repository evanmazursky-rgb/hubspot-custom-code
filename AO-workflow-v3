// ============================================================================
// WHAT THIS CODE DOES (big picture)
// ----------------------------------------------------------------------------
// This is a "custom code" step inside a HubSpot workflow. It runs whenever a
// contact reaches this step, and its job is to:
//
//   1. Look up all "Campaign Qualification" (CQ) records tied to that contact
//      that represent a live, unexpired special offer.
//   2. Throw out any CQs tied to buyers we've decided NOT to make offers for
//      (the EXCLUDED_BUYERS list below).
//   3. Figure out which campaign each remaining CQ belongs to, and whether
//      that campaign is our top-priority "ENT Retail AO" campaign.
//   4. If there are CQs in the priority Retail campaign AND the buyer is on
//      our approved retail list, pick the best one of those. Otherwise, pick
//      the best CQ from all the other ("non-retail") campaigns.
//   5. Look up a logo image for that buyer.
//   6. Hand back a big bundle of information (the "outputFields") that the
//      rest of the HubSpot workflow/email/page uses to personalize what the
//      contact sees (buyer name, discount amount, logo, etc).
//
// If at any point there's nothing usable to show (no CQs, all excluded,
// missing required info), it hands back a safe "empty" set of fields instead
// of guessing.
// ============================================================================

const hubspot = require('@hubspot/api-client');

// ----------------------------------------------------------------------------
// CONFIG / CONSTANTS
// These are the "knobs" for this code — the object types, the name of our
// top-priority campaign, and a fallback logo image to use if we can't find
// a real one for the buyer.
// ----------------------------------------------------------------------------
const CQ_TYPE = '2-66707814';              // HubSpot custom object: "Campaign Qualification" records
const CAMPAIGN_TYPE = '2-66707816';        // HubSpot custom object: "Campaign" records
const CAMPAIGN_ASSOCIATION_TYPE_ID = 353;  // The specific "link type" that connects a CQ to its Campaign
const PRIORITY_CAMPAIGN_NAME = 'ENT Retail AO campaign'; // Our top-priority campaign name
const NORMALIZED_PRIORITY_CAMPAIGN_NAME = PRIORITY_CAMPAIGN_NAME.trim().toLowerCase();
const FALLBACK_LOGO_URL =
  'https://50463701.fs1.hubspotusercontent-na1.net/hubfs/50463701/C2FO%20Logos/c2fo_2_color_logo_500.png'; // Generic logo used when we can't find the buyer's real logo

// ----------------------------------------------------------------------------
// SMALL HELPER FUNCTIONS
// These are little utilities used throughout the code to safely convert
// values (so the code doesn't crash if a field is missing or blank).
// ----------------------------------------------------------------------------

// Turns any value into a plain text string, and treats "missing" as an empty string
const text = (value) => (value == null ? '' : String(value));

// Turns a value into a number for comparisons; if it's not really a number,
// treat it as "as small as possible" so it never wins a priority comparison
const number = (value) =>
  Number.isFinite(Number(value)) ? Number(value) : Number.NEGATIVE_INFINITY;

// Cleans up a buyer name for comparison purposes: trims spaces, lowercases it,
// and standardizes curly apostrophes (’) to straight ones (') so
// "Macy's" always matches "Macy's" regardless of how it was typed
const normalizeBuyer = (value) =>
  text(value)
    .trim()
    .toLowerCase()
    .replace(/[’‘]/g, "'");

