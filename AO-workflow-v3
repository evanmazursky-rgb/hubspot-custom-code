// NOTE: labels were shortened (e.g. "Discount Amount" -> "Discount",
// "Early Payment Frequency" -> "Frequency") to match the latest sample HTML
// design, which reads cleaner on a narrow mobile column.

function formatTableCurrency(value, currency) {
  const amount = text(value).trim();

  if (text(currency).trim().toUpperCase() !== 'MXN' || !amount) {
    return amount;
  }

  return `MX$${amount.replace(/^(?:MX\$|\$)\s*/, '')}`;
}

function columnForOffer(offerType, payload, offerId, t) {
  const kind = offerKind(offerType);

  if (kind === 'preferred') {
    return {
      sortOrder: 0,
      title: t.preferredTitle,
      recommended: true,
      headerBg: '#EBF5FC',
      headerBorder: '#369DD9',
      titleColor: '#00528A',
      cellBg: '#F7FAFC',
      altCellBg: '#F9FAFB',
      buttonBg: '#369DD9',
      ar: formatTableCurrency(payload.eligible_invoice_amount, payload.currency),
      ratePercent: floorToTwoDecimals(payload.rate),
      discount: formatTableCurrency(payload.discount_amount, payload.currency),
      amount: formatTableCurrency(payload.discounted_amount, payload.currency),
      frequencyLabel: t.lockedFor90,
      offerId: text(offerId),
      whyTitle: t.whyPreferredTitle,
      whyBullets: t.whyPreferredBullets
    };
  }

  if (kind === 'onetime') {
    return {
      sortOrder: 1,
      title: t.oneTimeTitle,
      recommended: false,
      headerBg: '#F3F4F6',
      headerBorder: '#D1D5DB',
      titleColor: '#374151',
      cellBg: '#FFFFFF',
      altCellBg: '#F9FAFB',
      buttonBg: '#2C324F',
      ar: formatTableCurrency(payload.eligible_invoice_amount, payload.currency),
      ratePercent: floorToTwoDecimals(payload.rate),
      discount: formatTableCurrency(payload.discount_amount, payload.currency),
      amount: formatTableCurrency(payload.discounted_amount, payload.currency),
      frequencyLabel: t.oneTimeOnly,
      offerId: text(offerId),
      whyTitle: t.whyOneTimeTitle,
      whyBullets: t.whyOneTimeBullets
    };
  }

  return null;
}

function buildComparisonTable(offers, t) {
  const borderColor = '#E5E7EB';
  const labelColWidth = '34%';
  const dataColWidth = `${Math.floor(66 / Math.max(offers.length, 1))}%`;

  // Fixed-format cells (currency, %, fixed phrases like "One time only"):
  // never break internally. white-space:nowrap alone is NOT enough — a
  // client that boosts font size (or inherits HubSpot's break-word rule)
  // can still force a break inside the value, so word-break/overflow-wrap
  // are reset explicitly on every one of these cells.
  const fixedCellStyle = 'white-space:nowrap;word-break:normal;overflow-wrap:normal;';

  // Label cells: short but locale-variable ("Rate" vs "Frecuencia"). Allowed
  // to wrap onto a 2nd line at a word boundary — never forced nowrap (which
  // would blow out the column for a longer locale) and never inheriting
  // HubSpot's break-word (which is what fragmented "Discount Amount" into
  // "Disc/ount Amo/unt" on mobile).
  const labelCellStyle = 'white-space:normal;word-break:normal;overflow-wrap:break-word;';

  const headerCells = offers
    .map((o) => {
      const badge = o.recommended
        ? `<div style="display:inline-block;background:${o.buttonBg};color:#ffffff;font-size:9px;font-weight:bold;text-transform:uppercase;letter-spacing:0.5px;padding:2px 6px;border-radius:10px;margin-bottom:4px;">${escapeHtml(t.recommendedBadge)}</div><br/>`
        : '';
      return `<td width="${dataColWidth}" style="background:${o.headerBg};padding:12px 6px;text-align:center;border-bottom:2px solid ${o.headerBorder};border-radius:6px 6px 0 0;${fixedCellStyle}">${badge}<span style="font-size:15px;font-weight:700;color:${o.titleColor};">${escapeHtml(o.title)}</span></td>`;
    })
    .join('');

  const rowDefs = [
    { label: t.currentAR, render: (o) => escapeHtml(o.ar) },
    { label: t.rate, render: (o) => t.fixedApr(escapeHtml(o.ratePercent)) },
    { label: t.discountAmount, render: (o) => escapeHtml(o.discount) },
    {
      label: t.estimatedDeposit,
      render: (o) => `<span style="color:#059669;font-weight:700;">${escapeHtml(o.amount)}</span>`
    },
    { label: t.earlyPaymentFrequency, render: (o) => escapeHtml(o.frequencyLabel) },
    { label: t.paymentGuaranteed, render: () => '<span style="color:#10B981;font-weight:bold;">&#10003;</span>' }
  ];

  const dataRows = rowDefs
    .map((row, rowIndex) => {
      const stripe = rowIndex % 2 === 0;
      const cells = offers
        .map(
          (o) =>
            `<td align="center" width="${dataColWidth}" style="padding:8px 6px;background:${stripe ? o.cellBg : o.altCellBg};border-bottom:1px solid ${borderColor};vertical-align:middle;${fixedCellStyle}"><span style="font-size:13px;color:#374151;">${row.render(o)}</span></td>`
        )
        .join('');
      return `<tr><td width="${labelColWidth}" style="padding:8px 8px;font-weight:600;font-size:12px;color:#4B5563;border-bottom:1px solid ${borderColor};vertical-align:middle;background-color:${stripe ? '#ffffff' : '#F9FAFB'};line-height:1.3;${labelCellStyle}">${escapeHtml(row.label)}:</td>${cells}</tr>`;
    })
    .join('');

  const whyCells = offers
    .map((o) => {
      const bullets = o.whyBullets
        .map((b) => `<li style="margin:0 0 4px 0;">${escapeHtml(b)}</li>`)
        .join('');
      // No border-bottom here: this row sits directly above the button row,
      // so a divider between "Why ___?" and "Review Offer" just adds visual
      // clutter.
      return `<td width="${dataColWidth}" style="padding:10px 6px;background:${o.cellBg};vertical-align:top;${labelCellStyle}"><div style="font-weight:700;font-size:12px;color:#111827;margin-bottom:4px;">${escapeHtml(o.whyTitle)}</div><ul style="margin:0;padding-left:14px;font-size:11px;line-height:1.4;">${bullets}</ul></td>`;
    })
    .join('');
  const whyRow = `<tr><td width="${labelColWidth}" style="padding:10px 8px;background-color:#ffffff;"></td>${whyCells}</tr>`;

  const buttonCells = offers
    .map(
      (o) =>
        `<td align="center" width="${dataColWidth}" style="padding:14px 4px;background-color:${o.cellBg};vertical-align:middle;"><a href="https://app.c2fo.com?redirect-to=/enterprise/supplier/offer/${encodeURIComponent(o.offerId)}" style="background-color:${o.buttonBg};color:#ffffff;padding:10px 14px;text-decoration:none;border-radius:6px;display:inline-block;font-weight:600;font-size:12px;text-align:center;box-sizing:border-box;min-width:90px;${fixedCellStyle}">${escapeHtml(t.reviewOffer)}</a></td>`
    )
    .join('');
  const buttonRow = `<tr><td width="${labelColWidth}" style="background-color:#ffffff;"></td>${buttonCells}</tr>`;

  return `
<div style="width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;-webkit-text-size-adjust:100%;text-size-adjust:100%;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:560px;margin:0 auto;border-collapse:separate;border-spacing:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#111827;-webkit-text-size-adjust:100%;text-size-adjust:100%;">
  <tr>
    <td width="${labelColWidth}" style="background:#ffffff;"></td>
    ${headerCells}
  </tr>
${dataRows}
${whyRow}
${buttonRow}
</table>
</div>`.trim();
}

// ============================================================================
// MAIN ENTRY POINT
// ============================================================================
exports.main = async (event, callback) => {
  const client = new hubspot.Client({
    accessToken: process.env.PRIVATE_APP_ACCESS_TOKEN
  });

  // ---- STEP 1: Get the contact's unique ID and preferred language ----
  const auth = text(event.inputFields.contact_auth_uuid);
  const locale = resolveLocale(event.inputFields.contact_email_language);
  const t = LOCALES[locale];

  if (!auth) {
    return callback({ outputFields: emptyOutput(0) });
  }

  // ---- STEP 2: Search for this contact's live, unexpired offer records ----
  const response = await withRetry(
    () =>
      client.crm.objects.searchApi.doSearch(CQ_TYPE, {
        filterGroups: [
          {
            filters: [
              {
                propertyName: 'recipient_auth_service_uuid',
                operator: 'EQ',
                value: auth
              },
              {
                propertyName: 'payload_kind',
                operator: 'EQ',
                value: 'ACTIONABLE_OFFER'
              },
              {
                propertyName: 'expires_at',
                operator: 'GT',
                value: String(Date.now())
              }
            ]
          }
        ],
        properties: ['payload_json', 'source_run_started_at', 'expires_at'],
        limit: 100
      }),
    'Campaign Qualification search'
  );

  const records = response.results || [];

  // ---- STEP 3: Load each CQ's campaign details, then remove any records
  //              tied to excluded buyers. ----
  const candidates = await Promise.all(
    records.map(async (record) => {
      const payload = parsePayload(record);
      const buyerName = text(payload?.primary_buyer_name).trim();
      const buyerPermalink = text(payload?.primary_buyer_permalink).trim().toLowerCase();
      const offerType = normalizeOfferType(payload?.offer_type);
      const details = await campaignDetails(client, record.id);

      return {
        ...details,
        id: text(record.id),
        raw: text(record.properties?.[PAYLOAD_PROPERTY]),
        payload,
        buyerName,
        buyerPermalink,
        offerType,
        kind: offerKind(offerType),
        isRetailEligibleBuyer: RETAIL_ELIGIBLE_BUYERS.has(
          normalizeBuyer(buyerName)
        ),
        started: text(record.properties?.source_run_started_at)
      };
    })
  );

  const eligible = candidates.filter(
    (candidate) =>
      candidate.payload &&
      !EXCLUDED_BUYERS.has(normalizeBuyer(candidate.payload.primary_buyer_name))
  );

  if (!eligible.length) {
    return callback({ outputFields: emptyOutput(records.length) });
  }

  // ---- STEP 4: For each surviving record, we already know its campaign
  //              details (including whether that campaign is configured for
  //              more than one offer type, and whether it's a Reduced Rate
  //              campaign) and its own offer type/kind ----

  // ---- STEP 5: Split candidates into four pools, highest priority first.
  //              Reduced Rate is checked (and excluded from every pool
  //              below it) first, since it now outranks everything. ----
  const reducedRateCandidates = eligible.filter(
    (candidate) => candidate.isReducedRateCampaign
  );
  const topPriorityCandidates = eligible.filter(
    (candidate) => candidate.isTopPriorityCampaign && !candidate.isReducedRateCampaign
  );
  const eligibleRetailCandidates = eligible.filter(
    (candidate) =>
      candidate.isPriorityCampaign &&
      candidate.isRetailEligibleBuyer &&
      !candidate.isTopPriorityCampaign &&
      !candidate.isReducedRateCampaign
  );
  const nonRetailCandidates = eligible.filter(
    (candidate) =>
      !candidate.isPriorityCampaign &&
      !candidate.isTopPriorityCampaign &&
      !candidate.isReducedRateCampaign
  );

  const selectionPool =
    reducedRateCandidates.length > 0
      ? reducedRateCandidates
      : topPriorityCandidates.length > 0
        ? topPriorityCandidates
        : eligibleRetailCandidates.length > 0
          ? eligibleRetailCandidates
          : nonRetailCandidates;

  // ---- STEP 6: Pick the single best candidate from the chosen pool ----
  const selected = selectionPool.reduce(
    (current, item) => (current ? winner(current, item) : item),
    null
  );

  // ---- STEP 7: Group the winner with any other CQ from the exact same
  //              campaign + same campaign run (source_run_started_at) —
  //              this is what powers both cq_match_status and the offers
  //              table below. Only campaigns configured for more than one
  //              offer type (campaign_config.draftOfferAssets) are grouped
  //              this way at all. ----
  let cqMatchStatus = 'none';
  let sameRunGroup = [];

  if (selected) {
    const multiOfferConfigured = isMultiOfferCampaign(selected);

    sameRunGroup =
      multiOfferConfigured && selected.started
        ? eligible.filter(
            (candidate) =>
              candidate.campaignId &&
              candidate.campaignId === selected.campaignId &&
              text(candidate.started) === text(selected.started)
          )
        : [selected];

    if (reducedRateCandidates.length > 0) {
      cqMatchStatus = REDUCED_RATE_MATCH_STATUS;
    } else if (topPriorityCandidates.length > 0) {
      cqMatchStatus = TOP_PRIORITY_CAMPAIGN_NAME;
    } else if (eligibleRetailCandidates.length > 0) {
      cqMatchStatus = PRIORITY_CAMPAIGN_NAME;
    } else if (multiOfferConfigured && sameRunGroup.length > 1) {
      cqMatchStatus = 'multiple_matches';
    } else {
      // Whether there was exactly one qualifying non-retail CQ, or several
      // that didn't reduce to a clean same-campaign/same-run multi-offer-
      // type pair, downstream treats it the same: send the single-offer
      // email for whichever CQ won the priority + recency tie-break.
      cqMatchStatus = 'one_match';
    }
  }

  // ---- STEP 8: Log what happened, for visibility in HubSpot's workflow logs ----
  if (cqMatchStatus === REDUCED_RATE_MATCH_STATUS) {
    console.log(
      `cq_match_status=${REDUCED_RATE_MATCH_STATUS}: selected a CQ from a fixed-rate Reduced Rate campaign (${selected.campaignName || 'unknown'}), taking precedence over ${topPriorityCandidates.length} Lapse & Attrited CQ(s), ${eligibleRetailCandidates.length} eligible retail CQ(s), and ${nonRetailCandidates.length} other non-retail CQ(s).`
    );
  } else if (cqMatchStatus === TOP_PRIORITY_CAMPAIGN_NAME) {
    console.log(
      `cq_match_status=${TOP_PRIORITY_CAMPAIGN_NAME}: selected a CQ from the top-priority Lapse & Attrited campaign, taking precedence over ${eligibleRetailCandidates.length} eligible retail CQ(s) and ${nonRetailCandidates.length} other non-retail CQ(s). (${reducedRateCandidates.length} Reduced Rate CQ(s) were present.)`
    );
  } else if (cqMatchStatus === PRIORITY_CAMPAIGN_NAME) {
    console.log(
      `cq_match_status=${PRIORITY_CAMPAIGN_NAME}: selected an eligible ENT Retail CQ for an approved buyer, taking precedence over ${nonRetailCandidates.length} qualifying non-retail CQ(s).`
    );
  } else if (nonRetailCandidates.length > 0) {
    const excludedRetailCount = eligible.filter(
      (candidate) =>
        candidate.isPriorityCampaign &&
        !candidate.isRetailEligibleBuyer &&
        !candidate.isTopPriorityCampaign &&
        !candidate.isReducedRateCampaign
    ).length;

    console.log(
      `cq_match_status=${cqMatchStatus}: selected from ${nonRetailCandidates.length} qualifying non-retail CQ(s) (offers table built from ${sameRunGroup.length} CQ(s) in the same campaign run). Ignored ${excludedRetailCount} ineligible retail CQ(s).`
    );
  } else {
    console.log(
      `cq_match_status=none: no qualifying CQ was found in Reduced Rate, the top-priority campaign, the Retail priority campaign, or any other eligible campaign.`
    );
  }

  // ---- STEP 9: Sanity check the winning record before using it ----
  if (
    !selected?.raw ||
    !text(selected.payload?.primary_buyer_name).trim() ||
    !text(selected.payload?.primary_buyer_permalink).trim() ||
    !text(selected.payload?.primary_buyer_division_uuid).trim() ||
    !buyerFlag(selected.payload)
  ) {
    console.log(
      'Winning Campaign Qualification is missing buyer identity, buyer division UUID, or a valid number of customers'
    );

    return callback({ outputFields: emptyOutput(records.length) });
  }

  const payload = selected.payload;
  const buyerName = text(payload.primary_buyer_name).trim();
  const buyerPermalink = text(payload.primary_buyer_permalink).trim();
  const buyerDivisionUuid = text(payload.primary_buyer_division_uuid).trim();
  const flag = buyerFlag(payload);

  // The pre-discount ("standard") rate for a Reduced Rate winner lives in
  // the CQ payload's `original_pricing` block. For every other campaign
  // type this block won't be present, so these just come back blank — safe
  // to always compute unconditionally.
 const standardRateRaw = payload.original_pricing?.rate;
const standardRate = Number.isFinite(Number(standardRateRaw))
  ? Number(standardRateRaw).toFixed(2)
  : text(standardRateRaw);
const standardRateType = text(payload.original_pricing?.rate_type);

  // ---- STEP 10: Look up a logo image for this buyer ----
  let logo = FALLBACK_LOGO_URL;

  try {
    const logoResponse = await withRetry(
      () =>
        client.apiRequest({
          method: 'GET',
          path: '/cms/v3/hubdb/tables/buyer_logos/rows',
          qs: {
            buyer_key__eq:
              buyerPermalink.toLowerCase() || buyerName.toLowerCase(),
            limit: 1
          }
        }),
      'Buyer logo lookup'
    );

    const value = (await logoResponse.json()).results?.[0]?.values?.logo_url;
    logo =
      typeof value === 'string' && value
        ? value
        : value?.url || FALLBACK_LOGO_URL;
  } catch (error) {
    console.log(`Buyer logo lookup failed: ${error.message || error}`);
  }

  // ---- STEP 11: Build the draft offers table from sameRunGroup — one
  //               column per recognized offer type, in Preferred-then-
  //               One-Time order. ----
  const tableColumns = sameRunGroup
    .map((candidate) =>
      columnForOffer(candidate.offerType, candidate.payload, candidate.payload.draft_offer_uuid, t)
    )
    .filter(Boolean)
    .sort((a, b) => a.sortOrder - b.sortOrder);

  const draftOffersTable = tableColumns.length ? buildComparisonTable(tableColumns, t) : '';

  console.log(
    `Built draft offers table (locale=${locale}, buyer=${selected.buyerPermalink || 'unknown'}, campaign=${selected.campaignName || 'unknown'}, reducedRate=${selected.isReducedRateCampaign}) from ${sameRunGroup.length} CQ(s).`
  );

  // ---- STEP 12: Hand everything back to the workflow ----
  callback({
    outputFields: {
      matching_cq_count: String(selectionPool.length),
      raw_matching_cq_count: String(records.length),
      cq_match_status: cqMatchStatus,
      buyer_count_flag: flag,
      selected_offers_json: JSON.stringify(
        sameRunGroup.map((candidate) => ({
          cq_id: candidate.id,
          payload_json: candidate.raw,
          campaign_name: candidate.campaignName,
          campaign_priority: candidate.priority,
          source_run_started_at: candidate.started
        }))
      ),
      selected_primary_cq_id: selected.id,
      selected_primary_payload_json: selected.raw,
      draft_offers_table: draftOffersTable,
      campaign_user_status: selected.userStatus || 'null',
      buyer_logo_url: logo,
      auth_service_uuid: text(payload.auth_service_uuid),
      currency: text(payload.currency),
      discount_amount: text(payload.discount_amount),
      discounted_amount: text(payload.discounted_amount),
      draft_offer_uuid: text(payload.draft_offer_uuid),
      eligible_invoice_amount: text(payload.eligible_invoice_amount),
      good_funds_date_picker: formatDate(
        payload.good_funds_date_picker || payload.good_funds_date
      ),
      non_reg_buyer_exclusion_flag: 'no',
      leading_maker_organization_uuid: text(
        payload.leading_maker_organization_uuid
      ),
      number_of_customers: text(
        payload.number_of_customers ?? payload['number of customers']
      ),
      number_of_invoices: text(payload.number_of_invoices),
      primary_buyer_division_uuid: buyerDivisionUuid,
      primary_buyer_name: buyerName,
      primary_buyer_permalink: buyerPermalink,
      rate: Number.isFinite(Number(payload.rate))
        ? Number(payload.rate).toFixed(2)
        : text(payload.rate),
      rate_type: text(payload.rate_type),
      standard_rate: standardRate,
      standard_rate_type: standardRateType
    }
  });
};
