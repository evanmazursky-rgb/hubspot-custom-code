}

// Same rules as before, applied to campaign records that are already loaded.
function pickCampaignDetails(ids, campaignsById) {
  const campaigns = ids.map((id) => campaignsById.get(id)).filter(Boolean);

  const topPriorityCampaign = campaigns.find(
    (campaign) =>
      text(campaign.properties?.campaign_name).trim().toLowerCase() ===
      NORMALIZED_TOP_PRIORITY_CAMPAIGN_NAME
  );
  const priorityCampaign = campaigns.find(
    (campaign) =>
      text(campaign.properties?.campaign_name).trim().toLowerCase() ===
      NORMALIZED_PRIORITY_CAMPAIGN_NAME
  );
  // Which campaign "governs" this CQ, when a CQ is (unusually) tied to more
  // than one Campaign record: named top-priority campaign first, named
  // Retail priority campaign next, otherwise whichever has the highest
  // campaign_priority number. Reduced Rate status is determined afterward,
  // below, from whichever campaign was picked here — it isn't a name match,
  // so it doesn't factor into this pick.
  const campaign =
    topPriorityCampaign ||
    priorityCampaign ||
    campaigns
      .slice()
      .sort(
        (a, b) =>
          number(b.properties?.campaign_priority) -
          number(a.properties?.campaign_priority)
      )[0];

  if (!campaign) {
    return emptyCampaignDetails(ids);
  }

  let config = {};

  try {
    config = campaign.properties?.campaign_config
      ? JSON.parse(campaign.properties.campaign_config)
      : {};
  } catch {
    throw new Error(
      `AO Campaign ${campaign.id} campaign_config is not valid JSON`
    );
  }

  const campaignName = text(campaign.properties?.campaign_name).trim();
  const normalizedCampaignName = campaignName.toLowerCase();
  const draftOfferAssets = Array.isArray(config.draftOfferAssets)
    ? config.draftOfferAssets
    : [];

  return {
    campaignId: text(campaign.id),
    campaignIds: ids,
    campaignName,
    campaignUuid: text(campaign.properties?.campaign_uuid).trim().toLowerCase(),
    normalizedCampaignName,
    isTopPriorityCampaign: normalizedCampaignName === NORMALIZED_TOP_PRIORITY_CAMPAIGN_NAME,
    isPriorityCampaign: normalizedCampaignName === NORMALIZED_PRIORITY_CAMPAIGN_NAME,
    isReducedRateCampaign: isReducedRateCampaignConfig(draftOfferAssets),
    priority: number(campaign.properties?.campaign_priority),
    userStatus:
      config.userStatus == null ? 'null' : text(config.userStatus),
    draftOfferAssets
  };
}

// ----------------------------------------------------------------------------
// CAMPAIGN CACHE (all campaigns, remembered briefly)
// ----------------------------------------------------------------------------
const CAMPAIGN_CACHE_TTL_MS = 5 * 60 * 1000; // 0 = reload on every run
const CAMPAIGN_PROPERTIES = [
  'campaign_name',
  'campaign_priority',
  'campaign_config',
  'campaign_uuid'
];
const campaignCache = { loadedAt: 0, byId: new Map(), byUuid: new Map() };

async function refreshCampaignCache(client) {
  const byId = new Map();
  const byUuid = new Map();
  const seenCursors = new Set();
  let after;

  for (let page = 0; page < 50; page += 1) {
    const request = { properties: CAMPAIGN_PROPERTIES, limit: 100 };
    if (after != null) request.after = after;

    const response = await withRetry(
      () => client.crm.objects.searchApi.doSearch(CAMPAIGN_TYPE, request),
      'Campaign cache load'
    );

    for (const campaign of response.results || []) {
      byId.set(text(campaign.id), campaign);
      const uuid = text(campaign.properties?.campaign_uuid).trim().toLowerCase();
      if (uuid) byUuid.set(uuid, campaign);
    }

    const next = response.paging?.next?.after;
    if (next == null) {
      // One log line per load. Count these across a test batch: few lines means
      // the cache is being shared between contacts; about one per contact means
      // each contact runs in a fresh process and nothing is shared.
      const previousAgeSeconds = campaignCache.loadedAt
        ? Math.round((Date.now() - campaignCache.loadedAt) / 1000)
        : null;
      console.log(
        `Campaign cache loaded: ${byId.size} campaigns (${
          previousAgeSeconds == null
            ? 'cold start'
            : `replacing a copy ${previousAgeSeconds}s old`
        })`
      );

      campaignCache.byId = byId;
      campaignCache.byUuid = byUuid;
      campaignCache.loadedAt = Date.now();
      return;
    }

    const cursor = String(next);
    if (seenCursors.has(cursor)) {
      throw new Error('Campaign cache load returned a repeated pagination cursor');
    }
    seenCursors.add(cursor);
    after = next;
  }

  throw new Error('Campaign cache load exceeded its page safety limit');
}

async function getCampaignCache(client) {
  const age = Date.now() - campaignCache.loadedAt;
  if (CAMPAIGN_CACHE_TTL_MS <= 0 || age >= CAMPAIGN_CACHE_TTL_MS || !campaignCache.byId.size) {
    await refreshCampaignCache(client);
  }
  return campaignCache;
}

// Finds each offer's campaign details. Fast path: the offer's own campaign ID
// matched against the cached campaigns (no HubSpot call). Anything that cannot
// be matched that way goes through the original association lookup.
async function resolveCampaignDetails(client, items) {
  const details = new Map();
  let cache = null;

  try {
    cache = await getCampaignCache(client);
  } catch (error) {
    console.log(`Campaign cache unavailable; using association lookup: ${error.message || error}`);
  }

  const unresolved = [];

  for (const item of items) {
    const campaign =
      cache && item.sourceCampaignUuid ? cache.byUuid.get(item.sourceCampaignUuid) : undefined;

    if (campaign) {
      details.set(item.cqId, pickCampaignDetails([text(campaign.id)], cache.byId));
    } else {
      unresolved.push(item.cqId);
    }
  }

  if (unresolved.length) {
    const fallback = await loadCampaignDetails(client, unresolved);
    for (const [cqId, value] of fallback) details.set(cqId, value);
  }

  return details;
}

// Loads the campaign details for ALL of a contact's CQs with:
//   - one batch association read (CQ -> Campaign links), and
//   - one Campaign search (all campaigns at once).
// Returns Map<cqId, details>.
async function loadCampaignDetails(client, cqIds) {
  const idsByCq = new Map(cqIds.map((id) => [id, []]));

  for (const part of chunk(cqIds, 100)) {
    const response = await withRetry(
      () =>
        client.crm.associations.v4.batchApi.getPage(CQ_TYPE, CAMPAIGN_TYPE, {
          inputs: part.map((id) => ({ id }))
        }),
      'CQ association batch lookup'
    );

    for (const row of response.results || []) {
      // The SDK exposes the JSON key "from" as "_from".
      const cqId = text(row._from?.id ?? row.from?.id);
      const linked = (row.to || [])
        .filter((item) => {
          const types = Array.isArray(item.associationTypes) ? item.associationTypes : [];
          return (
            !types.length ||
            types.some((type) => String(type.typeId) === String(CAMPAIGN_ASSOCIATION_TYPE_ID))
          );
        })
        .map((item) => text(item.toObjectId))
        .filter(Boolean);

      if (cqId && idsByCq.has(cqId)) idsByCq.set(cqId, linked);
    }
  }

  const campaignsById = new Map();
  const allCampaignIds = [...new Set([...idsByCq.values()].flat())];

  for (const part of chunk(allCampaignIds, 100)) {
    const response = await withRetry(
      () =>
        client.crm.objects.searchApi.doSearch(CAMPAIGN_TYPE, {
          filterGroups: [
            {
              filters: [
                {
                  propertyName: 'hs_object_id',
                  operator: 'IN',
                  values: part
                }
              ]
            }
          ],
          properties: ['campaign_name', 'campaign_priority', 'campaign_config', 'campaign_uuid'],
          limit: 100
        }),
      'Campaign lookup'
    );

    for (const campaign of response.results || []) {
      campaignsById.set(text(campaign.id), campaign);
    }
  }

  return new Map(
    cqIds.map((cqId) => [cqId, pickCampaignDetails(idsByCq.get(cqId) || [], campaignsById)])
  );
}

// ----------------------------------------------------------------------------
// TIE-BREAKER: choosing the "best" CQ between two candidates
//   1. Whichever is tied to the higher-priority campaign wins.
//   2. If priority is tied, whichever was generated more recently
//      (source_run_started_at) wins.
// ----------------------------------------------------------------------------
function winner(first, second) {
  const priority = number(second.priority) - number(first.priority);
 
  if (priority) {
    return priority < 0 ? first : second;
  }
 
  const started = timestamp(second.started) - timestamp(first.started);
  return started < 0 ? first : second;
}
 
