// ----------------------------------------------------------------------------
// RELIABILITY HELPERS
// ----------------------------------------------------------------------------
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

const retryable = (error) => {
  const status = Number(
    error?.response?.statusCode ?? error?.statusCode ?? error?.status
  );

  return (
    status === 429 ||
    status >= 500 ||
    ['ECONNRESET', 'ETIMEDOUT', 'EAI_AGAIN'].includes(error?.code)
  );
};

async function withRetry(operation, label) {
  for (let attempt = 0; ; attempt += 1) {
    try {
      return await operation();
    } catch (error) {
      if (!retryable(error) || attempt >= 2) {
        throw error;
      }

      const wait = 250 * (attempt + 1);
      console.log(`${label} transient failure; retrying in ${wait}ms`);
      await sleep(wait);
    }
  }
}

// ----------------------------------------------------------------------------
// READING THE OFFER DETAILS OFF A CQ RECORD
// ----------------------------------------------------------------------------
function parsePayload(record) {
  const raw = text(record.properties?.[PAYLOAD_PROPERTY]);

  if (!raw.trim()) {
    return null;
  }

  try {
    return JSON.parse(raw);
  } catch {
    throw new Error(
      `Campaign Qualification ${record.id} payload_json is not valid JSON`
    );
  }
}

// ----------------------------------------------------------------------------
// DATE HELPERS
// ----------------------------------------------------------------------------
function timestamp(value) {
  const raw = text(value).trim();

  if (!raw) {
    return Number.NEGATIVE_INFINITY;
  }

  const date = /^\d+$/.test(raw) ? new Date(Number(raw)) : new Date(raw);
  return Number.isNaN(date.getTime())
    ? Number.NEGATIVE_INFINITY
    : date.getTime();
}

function formatDate(value) {
  const raw = text(value).trim();

  if (!raw) {
    return '';
  }

  const date = /^\d+$/.test(raw) ? new Date(Number(raw)) : new Date(raw);

  return Number.isNaN(date.getTime())
    ? raw
    : date.toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric'
      });
}

// ----------------------------------------------------------------------------
// BUYER / OFFER BUSINESS LOGIC
// ----------------------------------------------------------------------------
function customerCount(payload) {
  const value =
    payload?.number_of_customers ?? payload?.['number of customers'];

  if (value == null || text(value).trim() === '') {
    return null;
  }

  const parsed = Number(value);
  return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
}

function buyerFlag(payload) {
  const count = customerCount(payload);

  if (count == null) {
    return null;
  }

  return count === 1 ? 'single_buyer' : 'multi_buyer';
}

// Classifies a normalized offer_type (from a CQ's payload_json) into the two
// kinds the offers table knows how to display. Returns null for anything else.
function offerKind(offerType) {
  if (offerType === 'preferred-term') return 'preferred';
  if (offerType.startsWith('express-accept')) return 'onetime';
  return null;
}

// Reads a campaign's `campaign_config.draftOfferAssets` and answers: is this
// campaign configured to generate MORE THAN ONE offer type per qualifying
// run? (e.g. draftOfferAssets: [{ offerTypes: ["PREFERRED","EXPRESS_ACCEPT"] }])
// The default/common case is a single asset with a single offer type
// (typically just EXPRESS_ACCEPT), which returns false here.
function isMultiOfferCampaign(candidate) {
  return (candidate.draftOfferAssets || []).some(
    (asset) => Array.isArray(asset?.offerTypes) && asset.offerTypes.length > 1
  );
}

// Reads a campaign's `campaign_config.draftOfferAssets` and answers: is this
// a Reduced Rate campaign — i.e. does ANY draft offer asset use a fixed,
// pre-set discount rate (`rateSourceKind: "fixed"`) instead of a normal
// market-priced one (`rateSourceKind: "standard"`)? This is what identifies
// a campaign as Reduced Rate, dynamically, with no maintained list of
// campaign names/UUIDs required.
function isReducedRateCampaignConfig(draftOfferAssets) {
  return (draftOfferAssets || []).some(
    (asset) => text(asset?.rateSourceKind).trim().toLowerCase() === 'fixed'
  );
}

